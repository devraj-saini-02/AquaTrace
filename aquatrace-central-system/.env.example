# Postgres
# Local (docker-compose): postgresql+asyncpg://USER:PASSWORD@localhost:5432/contamination_cc
# Supabase: use the direct connection or Session pooler (NOT the Transaction pooler on 6543 —
# asyncpg's server-side prepared statements break under PgBouncer transaction mode), swap the
# postgresql:// scheme for postgresql+asyncpg://, and append ?ssl=require
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@localhost:5432/contamination_cc

# MQTT broker
# Local Mosquitto: localhost/1883, MQTT_USE_TLS=false, leave username/password blank
# Cloud (e.g. HiveMQ Cloud): <cluster>.hivemq.cloud/8883, MQTT_USE_TLS=true, set credentials
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_USE_TLS=false

# Windows
RETENTION_HOURS=12

# Baselining (shortened for demo; real system uses 24-48h)
BASELINING_PERIOD_SECONDS=90

# Simulation control proxy (demo-only — see README §Simulation Control Proxy). Set to node/'s
# own deployed URL (e.g. https://<your-node-service>.onrender.com) once it's deployed.
NODE_ORCHESTRATOR_URL=http://localhost:8100

# OTA model file serving — this service's own externally-reachable base URL (nodes download
# pushed models from PUBLIC_URL/models/file/{contaminant_id}/{version}) and the local directory
# pushed model files are copied into. Set PUBLIC_URL to this service's own deployed URL.
PUBLIC_URL=http://localhost:8000
MODEL_FILES_DIR=./model_files

# dashboard/'s origin(s), comma-separated, e.g. https://your-app.vercel.app — "*" (any origin)
# is fine for the local demo, not for a public deployment
CORS_ALLOW_ORIGINS=*

# Async DB connection pool — keep small against a managed Postgres free tier's connection cap
# (e.g. Supabase); local load testing can afford to raise these
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

# Logging
LOG_LEVEL=INFO

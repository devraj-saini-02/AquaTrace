# MQTT broker (must match central-system's broker)
# Local Mosquitto: localhost/1883, MQTT_USE_TLS=false, leave username/password blank
# Cloud (e.g. HiveMQ Cloud): <cluster>.hivemq.cloud/8883, MQTT_USE_TLS=true, set credentials
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_USE_TLS=false

# Simulation defaults
SIM_TIME_SCALE=120          # 1 real second = this many simulated seconds
DEFAULT_NODE_COUNT=15
SIM_SEED=42

# Model artifacts
MODEL_ARTIFACT_DIR=./ml/artifacts

# CC's REST API (only used for the OTA model-file HTTP download, see README §Model file transfer)
# Set to central-system's own deployed URL (e.g. https://<your-central-system>.onrender.com)
CC_API_BASE_URL=http://localhost:8000

# Orchestrator's own FastAPI port (local dev only — a platform like Render injects its own PORT
# and the start command should bind to that instead, see README §Deploying)
ORCHESTRATOR_PORT=8100

LOG_LEVEL=INFO
